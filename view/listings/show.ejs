<!-- Property Header -->
<section class="property-header bg-white py-4 border-bottom">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-8">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a href="/listings" class="text-decoration-none">Properties</a></li>
            <li class="breadcrumb-item active" aria-current="page"><%= listing.location %></li>
          </ol>
        </nav>
        <h1 class="h2 fw-bold text-dark mb-1"><%= listing.title %></h1>
        <div class="d-flex align-items-center gap-3 text-muted">
          <div class="d-flex align-items-center">
            <i class="fas fa-star text-warning me-1"></i>
            <span class="fw-semibold">4.<%= Math.floor(Math.random() * 9) + 1 %></span>
            <span class="ms-1">(<%= Math.floor(Math.random() * 500) + 50 %> reviews)</span>
          </div>
          <div><i class="fas fa-map-marker-alt me-1"></i><%= listing.location %>, <%= listing.country %></div>
        </div>
      </div>
      <div class="col-md-4 text-md-end">
        <div class="d-flex align-items-center justify-content-md-end gap-3">
          <% if (currentUser) { %>
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-primary btn-sm">
              <i class="fas fa-edit me-1"></i>Edit
            </a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
              <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to delete this listing?')">
                <i class="fas fa-trash me-1"></i>Delete
              </button>
            </form>
          <% } %>
          <button class="btn btn-outline-secondary btn-sm">
            <i class="far fa-heart me-1"></i>Save
          </button>
          <button class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-share me-1"></i>Share
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="container py-4">
  <div class="row">
    <!-- Main Content -->
    <div class="col-lg-8">
      <!-- Image Gallery -->
      <div class="property-gallery mb-4">
        <div class="row g-2">
          <div class="col-md-8">
            <div class="gallery-main position-relative property-gallery-main">
              <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="w-100 h-100 object-fit-cover" onerror="this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=60'">
              <div class="position-absolute top-0 end-0 m-3">
                <button class="btn btn-light rounded-pill px-3 py-1">
                  <i class="fas fa-camera me-1"></i>View All Photos
                </button>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="row g-2">
              <div class="col-12">
                <div class="property-gallery-thumb">
                  <img src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=60" alt="Room view" class="w-100 h-100 object-fit-cover">
                </div>
              </div>
              <div class="col-12">
                <div class="property-gallery-thumb">
                  <img src="https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=60" alt="Bathroom" class="w-100 h-100 object-fit-cover">
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Property Description -->
      <div class="property-description mb-4">
        <h3 class="h4 fw-bold mb-3">About this property</h3>
        <p class="text-muted mb-4"><%= listing.description %></p>

        <!-- Key Features -->
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <div class="d-flex align-items-center p-3 bg-light rounded">
              <i class="fas fa-users text-primary me-3 property-feature-icon"></i>
              <div>
                <div class="fw-semibold">Max Guests</div>
                <small class="text-muted">4 guests</small>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="d-flex align-items-center p-3 bg-light rounded">
              <i class="fas fa-bed text-primary me-3 property-feature-icon"></i>
              <div>
                <div class="fw-semibold">Bedrooms</div>
                <small class="text-muted">2 bedrooms</small>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="d-flex align-items-center p-3 bg-light rounded">
              <i class="fas fa-bath text-primary me-3 property-feature-icon"></i>
              <div>
                <div class="fw-semibold">Bathrooms</div>
                <small class="text-muted">1 bathroom</small>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Amenities -->
      <div class="property-amenities mb-4">
        <h3 class="h4 fw-bold mb-3">Amenities</h3>
        <div class="row g-3">
          <div class="col-md-6">
            <div class="d-flex align-items-center mb-2">
              <i class="fas fa-wifi text-primary me-3"></i>
              <span>Free WiFi</span>
            </div>
            <div class="d-flex align-items-center mb-2">
              <i class="fas fa-swimming-pool text-primary me-3"></i>
              <span>Swimming Pool</span>
            </div>
            <div class="d-flex align-items-center mb-2">
              <i class="fas fa-car text-primary me-3"></i>
              <span>Free Parking</span>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-center mb-2">
              <i class="fas fa-utensils text-primary me-3"></i>
              <span>Kitchen</span>
            </div>
            <div class="d-flex align-items-center mb-2">
              <i class="fas fa-tv text-primary me-3"></i>
              <span>TV</span>
            </div>
            <div class="d-flex align-items-center mb-2">
              <i class="fas fa-snowflake text-primary me-3"></i>
              <span>Air Conditioning</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Reviews -->
      <div class="property-reviews mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="h4 fw-bold mb-0">Reviews (<%= listing.reviews ? listing.reviews.length : 0 %>)</h3>
          <% if (currentUser) { %>
            <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#reviewModal">
              <i class="fas fa-star me-1"></i>Write a Review
            </button>
          <% } else { %>
            <a href="/login" class="btn btn-outline-primary btn-sm">
              <i class="fas fa-star me-1"></i>Login to Review
            </a>
          <% } %>
        </div>

        <% if (listing.reviews && listing.reviews.length > 0) { %>
          <% listing.reviews.forEach(review => { %>
            <div class="review-item border-bottom py-3">
              <div class="d-flex align-items-start gap-3">
                <div class="review-avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center">
                  <%= review.author ? review.author.username.charAt(0).toUpperCase() : 'U' %>
                </div>
                <div class="flex-grow-1">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                      <h6 class="mb-0 fw-semibold"><%= review.author ? review.author.username : 'Anonymous' %></h6>
                      <small class="text-muted"><%= new Date(review.createdAt).toLocaleDateString() %></small>
                    </div>
                    <div class="d-flex">
                      <% for (let i = 1; i <= 5; i++) { %>
                        <% if (i <= review.rating) { %>
                          <i class="fas fa-star text-warning"></i>
                        <% } else { %>
                          <i class="far fa-star text-warning"></i>
                        <% } %>
                      <% } %>
                    </div>
                  </div>
                  <p class="text-muted mb-0"><%= review.comment %></p>
                  <% if (currentUser && review.author && review.author._id.toString() === currentUserId) { %>
                    <div class="mt-2">
                      <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this review?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                          <i class="fas fa-trash me-1"></i>Delete Review
                        </button>
                      </form>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="text-center py-4">
            <i class="fas fa-comments text-muted no-reviews-icon"></i>
            <p class="text-muted mt-2">No reviews yet. Be the first to share your experience!</p>
          </div>
        <% } %>
      </div>

      <!-- Location/Map Section -->
      <div class="property-location mb-4">
        <h3 class="h4 fw-bold mb-3">Location</h3>
        <div class="mb-3">
          <i class="fas fa-map-marker-alt text-primary me-2"></i>
          <span class="fw-semibold"><%= listing.location %>, <%= listing.country %></span>
        </div>
        <div id="map" style="width: 100%; height: 400px; border-radius: 8px; background: #f8f9fa; display: block !important; visibility: visible !important;" class="shadow-sm">
          <!-- Loading placeholder -->
          <div class="d-flex align-items-center justify-content-center h-100 bg-light rounded">
            <div class="text-center text-muted">
              <i class="fas fa-spinner fa-spin fa-3x mb-3"></i>
              <p>Loading map...</p>
              <small>Please wait while we load the interactive map</small>
            </div>
          </div>
        </div>

        <!-- Map Legend -->
        <div class="mt-3 p-3 bg-light rounded" id="map-legend" style="display: none;">
          <h6 class="mb-2"><i class="fas fa-info-circle me-1"></i>Map Legend</h6>
          <div class="row g-2">
            <div class="col-6">
              <div class="d-flex align-items-center">
                <i class="fas fa-home me-2" style="color: #667eea; font-size: 16px;"></i>
                <small>Your Property</small>
              </div>
            </div>
            <div class="col-6">
              <div class="d-flex align-items-center">
                <i class="fas fa-hotel me-2" style="color: #e74c3c; font-size: 16px;"></i>
                <small>Hotels</small>
              </div>
            </div>
            <div class="col-6">
              <div class="d-flex align-items-center">
                <i class="fas fa-camera me-2" style="color: #27ae60; font-size: 16px;"></i>
                <small>Attractions</small>
              </div>
            </div>
            <div class="col-6">
              <div class="d-flex align-items-center">
                <i class="fas fa-utensils me-2" style="color: #f39c12; font-size: 16px;"></i>
                <small>Restaurants</small>
              </div>
            </div>
            <div class="col-6">
              <div class="d-flex align-items-center">
                <i class="fas fa-school me-2" style="color: #9b59b6; font-size: 16px;"></i>
                <small>Schools</small>
              </div>
            </div>
            <div class="col-6">
              <div class="d-flex align-items-center">
                <i class="fas fa-hospital me-2" style="color: #e74c3c; font-size: 16px;"></i>
                <small>Hospitals</small>
              </div>
            </div>
            <div class="col-6">
              <div class="d-flex align-items-center">
                <i class="fas fa-shopping-cart me-2" style="color: #f39c12; font-size: 16px;"></i>
                <small>Shopping</small>
              </div>
            </div>
            <div class="col-6">
              <div class="d-flex align-items-center">
                <i class="fas fa-plane me-2" style="color: #3498db; font-size: 16px;"></i>
                <small>Transport</small>
              </div>
            </div>
            <div class="col-6">
              <div class="d-flex align-items-center">
                <i class="fas fa-university me-2" style="color: #2ecc71; font-size: 16px;"></i>
                <small>Banks</small>
              </div>
            </div>
            <div class="col-6">
              <div class="d-flex align-items-center">
                <span class="me-2" style="color: #ff0000; font-size: 12px;">●</span>
                <small>Distance Points</small>
              </div>
            </div>
            <div class="col-12 mt-2">
              <small class="text-muted"><i class="fas fa-lightbulb me-1"></i>Use the buttons above the map to explore nearby places and calculate distances!</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Booking Sidebar -->
    <div class="col-lg-4">
      <div class="booking-card bg-white rounded shadow-sm p-4 sticky-top">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <span class="h4 fw-bold text-primary mb-0">₹<%= listing.price %></span>
            <small class="text-muted">/night</small>
          </div>
          <div class="text-end">
            <div class="d-flex align-items-center text-muted small">
              <i class="fas fa-star text-warning me-1"></i>
              <span>4.<%= Math.floor(Math.random() * 9) + 1 %></span>
            </div>
          </div>
        </div>

        <!-- Booking Form -->
        <form class="booking-form">
          <div class="mb-3">
            <label class="form-label fw-semibold">Check-in</label>
            <input type="date" class="form-control" id="checkin">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Check-out</label>
            <input type="date" class="form-control" id="checkout">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Guests</label>
            <select class="form-select" id="guests">
              <option>1 guest</option>
              <option>2 guests</option>
              <option>3 guests</option>
              <option>4 guests</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-3 fw-semibold mb-3 btn-reserve">
            Reserve Now
          </button>

          <p class="text-center text-muted small mb-3">You won't be charged yet</p>

          <!-- Price Breakdown -->
          <div class="price-breakdown">
            <div class="d-flex justify-content-between mb-2">
              <span>₹<%= listing.price %></span> × 5 nights
              <span>₹<%= listing.price * 5 %></span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span>Cleaning fee</span>
              <span>₹3,700</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span>Service fee</span>
              <span>₹5,550</span>
            </div>
            <hr class="my-2">
            <div class="d-flex justify-content-between fw-bold">
              <span>Total</span>
              <span class="total-price">₹<%= listing.price * 5 + 9250 %></span>
            </div>
          </div>
        </form>

        <!-- Trust Badges -->
        <div class="trust-badges text-center mt-4 pt-3 border-top">
          <div class="row g-2">
            <div class="col-4">
              <div class="text-center">
                <i class="fas fa-shield-alt text-primary trust-badge-icon"></i>
                <div class="small text-muted mt-1">Secure</div>
              </div>
            </div>
            <div class="col-4">
              <div class="text-center">
                <i class="fas fa-undo text-info trust-badge-icon"></i>
                <div class="small text-muted mt-1">Free Cancel</div>
              </div>
            </div>
            <div class="col-4">
              <div class="text-center">
                <i class="fas fa-clock text-warning trust-badge-icon"></i>
                <div class="small text-muted mt-1">24/7 Support</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

