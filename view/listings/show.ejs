<!-- Review Modal -->
<% if (currentUser) { %>
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="reviewModalLabel">Write a Review</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="POST" action="/listings/<%= listing._id %>/reviews">
        <div class="modal-body">
          <div class="mb-3">
            <label for="rating" class="form-label fw-semibold">Rating</label>
            <select class="form-select" id="rating" name="review[rating]" required>
              <option value="">Select rating</option>
              <option value="5">⭐⭐⭐⭐⭐ Excellent (5)</option>
              <option value="4">⭐⭐⭐⭐ Very Good (4)</option>
              <option value="3">⭐⭐⭐ Good (3)</option>
              <option value="2">⭐⭐ Fair (2)</option>
              <option value="1">⭐ Poor (1)</option>
            </select>
          </div>
          <div class="mb-3">
            <label for="comment" class="form-label fw-semibold">Your Review</label>
            <textarea class="form-control" id="comment" name="review[comment]" rows="4" placeholder="Share your experience..." required minlength="5" maxlength="500"></textarea>
            <div class="form-text">Minimum 5 characters, maximum 500 characters</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Submit Review</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<!-- Map Initialization Script -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    console.log('Map initialization starting...');

    // Check if mapboxgl is loaded
    if (typeof mapboxgl === 'undefined') {
      console.error('Mapbox GL JS is not loaded');
      document.getElementById('map').innerHTML = `
        <div class="d-flex align-items-center justify-content-center h-100 bg-light rounded">
          <div class="text-center text-muted">
            <i class="fas fa-exclamation-triangle fa-3x mb-3 text-warning"></i>
            <p>Map library failed to load</p>
            <small>Please check your internet connection</small>
          </div>
        </div>
      `;
      return;
    }

    <% if (listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2) { %>
    console.log('Geometry condition met, initializing map');
    try {
      console.log('Starting map creation');
      // Initialize map
      mapboxgl.accessToken = '<%= mapboxToken %>';
      console.log('Mapbox token set:', mapboxgl.accessToken ? 'Yes' : 'No');

      const mapContainer = document.getElementById('map');
      console.log('Map container found:', !!mapContainer);

      const map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/streets-v12',
        center: [<%= listing.geometry.coordinates[0] %>, <%= listing.geometry.coordinates[1] %>],
        zoom: 12
      });

      console.log('Map created successfully');

      // Immediately clear loading content
      const loadingElements = mapContainer.querySelectorAll('.bg-light');
      loadingElements.forEach(el => el.remove());
      console.log('Loading elements removed:', loadingElements.length);

      // Add event listener for map load
      map.on('load', function() {
        console.log('Map loaded successfully');
        // Map is already cleared above

        // Add navigation controls
        map.addControl(new mapboxgl.NavigationControl());
        map.addControl(new mapboxgl.FullscreenControl());

        // Add geolocate control
        map.addControl(new mapboxgl.GeolocateControl({
          positionOptions: {
            enableHighAccuracy: true
          },
          trackUserLocation: true,
          showUserHeading: true
        }));

        // Add scale control
        map.addControl(new mapboxgl.ScaleControl());

        // Store markers for cleanup
        let nearbyMarkers = [];
        let directionsMarkers = [];

        // Create main property marker
        const mainMarkerElement = document.createElement('div');
        mainMarkerElement.innerHTML = '<i class="fas fa-home" style="font-size: 30px; color: #667eea;"></i>';
        mainMarkerElement.style.width = '30px';
        mainMarkerElement.style.height = '30px';
        mainMarkerElement.style.display = 'flex';
        mainMarkerElement.style.alignItems = 'center';
        mainMarkerElement.style.justifyContent = 'center';

        const mainPopup = new mapboxgl.Popup({ offset: 25 })
          .setHTML(`
            <div class="text-center">
