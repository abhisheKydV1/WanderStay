<!-- Property Header -->
<section class="property-header bg-white py-4 border-bottom">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-8">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a href="/listings" class="text-decoration-none">Properties</a></li>
            <li class="breadcrumb-item active" aria-current="page"><%= listing.location %></li>
          </ol>
        </nav>
        <h1 class="h2 fw-bold text-dark mb-1"><%= listing.title %></h1>
        <div class="d-flex align-items-center gap-3 text-muted">
          <div class="d-flex align-items-center">
            <i class="fas fa-star text-warning me-1"></i>
            <span class="fw-semibold">4.<%= Math.floor(Math.random() * 9) + 1 %></span>
            <span class="ms-1">(<%= Math.floor(Math.random() * 500) + 50 %> reviews)</span>
          </div>
          <div><i class="fas fa-map-marker-alt me-1"></i><%= listing.location %>, <%= listing.country %></div>
        </div>
      </div>
      <div class="col-md-4 text-md-end">
        <div class="d-flex align-items-center justify-content-md-end gap-3">
          <% if (currentUser) { %>
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-primary btn-sm">
              <i class="fas fa-edit me-1"></i>Edit
            </a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
              <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to delete this listing?')">
                <i class="fas fa-trash me-1"></i>Delete
              </button>
            </form>
          <% } %>
          <button class="btn btn-outline-secondary btn-sm">
            <i class="far fa-heart me-1"></i>Save
          </button>
          <button class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-share me-1"></i>Share
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="container py-4">
  <div class="row">
    <!-- Main Content -->
    <div class="col-lg-8">
      <!-- Image Gallery -->
      <div class="property-gallery mb-4">
        <div class="row g-2">
          <div class="col-md-8">
            <div class="gallery-main position-relative" style="height: 400px; overflow: hidden; border-radius: 12px;">
              <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="w-100 h-100 object-fit-cover">
              <div class="position-absolute top-0 end-0 m-3">
                <button class="btn btn-light rounded-pill px-3 py-1">
                  <i class="fas fa-camera me-1"></i>View All Photos
                </button>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="row g-2">
              <div class="col-12">
                <div style="height: 196px; overflow: hidden; border-radius: 12px;">
                  <img src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=60" alt="Room view" class="w-100 h-100 object-fit-cover">
                </div>
              </div>
              <div class="col-12">
                <div style="height: 196px; overflow: hidden; border-radius: 12px;">
                  <img src="https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=60" alt="Bathroom" class="w-100 h-100 object-fit-cover">
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Property Description -->
      <div class="property-description mb-4">
        <h3 class="h4 fw-bold mb-3">About this property</h3>
        <p class="text-muted mb-4"><%= listing.description %></p>

        <!-- Key Features -->
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <div class="d-flex align-items-center p-3 bg-light rounded">
              <i class="fas fa-users text-primary me-3" style="font-size: 24px;"></i>
              <div>
                <div class="fw-semibold">Max Guests</div>
                <small class="text-muted">4 guests</small>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="d-flex align-items-center p-3 bg-light rounded">
              <i class="fas fa-bed text-primary me-3" style="font-size: 24px;"></i>
              <div>
                <div class="fw-semibold">Bedrooms</div>
                <small class="text-muted">2 bedrooms</small>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="d-flex align-items-center p-3 bg-light rounded">
              <i class="fas fa-bath text-primary me-3" style="font-size: 24px;"></i>
              <div>
                <div class="fw-semibold">Bathrooms</div>
                <small class="text-muted">1 bathroom</small>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Amenities -->
      <div class="property-amenities mb-4">
        <h3 class="h4 fw-bold mb-3">Amenities</h3>
        <div class="row g-3">
          <div class="col-md-6">
            <div class="d-flex align-items-center mb-2">
              <i class="fas fa-wifi text-primary me-3"></i>
              <span>Free WiFi</span>
            </div>
            <div class="d-flex align-items-center mb-2">
              <i class="fas fa-swimming-pool text-primary me-3"></i>
              <span>Swimming Pool</span>
            </div>
            <div class="d-flex align-items-center mb-2">
              <i class="fas fa-car text-primary me-3"></i>
              <span>Free Parking</span>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-center mb-2">
              <i class="fas fa-utensils text-primary me-3"></i>
              <span>Kitchen</span>
            </div>
            <div class="d-flex align-items-center mb-2">
              <i class="fas fa-tv text-primary me-3"></i>
              <span>TV</span>
            </div>
            <div class="d-flex align-items-center mb-2">
              <i class="fas fa-snowflake text-primary me-3"></i>
              <span>Air Conditioning</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Reviews -->
      <div class="property-reviews mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="h4 fw-bold mb-0">Reviews (<%= listing.reviews ? listing.reviews.length : 0 %>)</h3>
          <% if (currentUser) { %>
            <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#reviewModal">
              <i class="fas fa-star me-1"></i>Write a Review
            </button>
          <% } else { %>
            <a href="/login" class="btn btn-outline-primary btn-sm">
              <i class="fas fa-star me-1"></i>Login to Review
            </a>
          <% } %>
        </div>

        <% if (listing.reviews && listing.reviews.length > 0) { %>
          <% listing.reviews.forEach(review => { %>
            <div class="review-item border-bottom py-3">
              <div class="d-flex align-items-start gap-3">
                <div class="review-avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-weight: bold;">
                  <%= review.author ? review.author.username.charAt(0).toUpperCase() : 'U' %>
                </div>
                <div class="flex-grow-1">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                      <h6 class="mb-0 fw-semibold"><%= review.author ? review.author.username : 'Anonymous' %></h6>
                      <small class="text-muted"><%= new Date(review.createdAt).toLocaleDateString() %></small>
                    </div>
                    <div class="d-flex">
                      <% for (let i = 1; i <= 5; i++) { %>
                        <% if (i <= review.rating) { %>
                          <i class="fas fa-star text-warning"></i>
                        <% } else { %>
                          <i class="far fa-star text-warning"></i>
                        <% } %>
                      <% } %>
                    </div>
                  </div>
                  <p class="text-muted mb-0"><%= review.comment %></p>
                  <% if (currentUser && review.author && review.author._id.toString() === currentUserId) { %>
                    <div class="mt-2">
                      <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this review?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                          <i class="fas fa-trash me-1"></i>Delete Review
                        </button>
                      </form>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="text-center py-4">
            <i class="fas fa-comments text-muted" style="font-size: 48px;"></i>
            <p class="text-muted mt-2">No reviews yet. Be the first to share your experience!</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Booking Sidebar -->
    <div class="col-lg-4">
      <div class="booking-card bg-white rounded shadow-sm p-4 sticky-top" style="top: 20px;">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <span class="h4 fw-bold text-primary mb-0">₹<%= listing.price %></span>
            <small class="text-muted">/night</small>
          </div>
          <div class="text-end">
            <div class="d-flex align-items-center text-muted small">
              <i class="fas fa-star text-warning me-1"></i>
              <span>4.<%= Math.floor(Math.random() * 9) + 1 %></span>
            </div>
          </div>
        </div>

        <!-- Booking Form -->
        <form class="booking-form">
          <div class="mb-3">
            <label class="form-label fw-semibold">Check-in</label>
            <input type="date" class="form-control" id="checkin">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Check-out</label>
            <input type="date" class="form-control" id="checkout">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Guests</label>
            <select class="form-select" id="guests">
              <option>1 guest</option>
              <option>2 guests</option>
              <option>3 guests</option>
              <option>4 guests</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-3 fw-semibold mb-3" style="background-color: #1ba0d7; border: none;">
            Reserve Now
          </button>

          <p class="text-center text-muted small mb-3">You won't be charged yet</p>

          <!-- Price Breakdown -->
          <div class="price-breakdown">
            <div class="d-flex justify-content-between mb-2">
              <span>₹<%= listing.price %></span> × 5 nights
              <span>₹<%= listing.price * 5 %></span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span>Cleaning fee</span>
              <span>₹3,700</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span>Service fee</span>
              <span>₹5,550</span>
            </div>
            <hr class="my-2">
            <div class="d-flex justify-content-between fw-bold">
              <span>Total</span>
              <span class="total-price">₹<%= listing.price * 5 + 9250 %></span>
            </div>
          </div>
        </form>

        <!-- Trust Badges -->
        <div class="trust-badges text-center mt-4 pt-3 border-top">
          <div class="row g-2">
            <div class="col-4">
              <div class="text-center">
                <i class="fas fa-shield-alt text-primary" style="font-size: 24px;"></i>
                <div class="small text-muted mt-1">Secure</div>
              </div>
            </div>
            <div class="col-4">
              <div class="text-center">
                <i class="fas fa-undo text-info" style="font-size: 24px;"></i>
                <div class="small text-muted mt-1">Free Cancel</div>
              </div>
            </div>
            <div class="col-4">
              <div class="text-center">
                <i class="fas fa-clock text-warning" style="font-size: 24px;"></i>
                <div class="small text-muted mt-1">24/7 Support</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Similar Properties -->
<section class="similar-properties py-5 bg-light">
  <div class="container">
    <h3 class="h4 fw-bold text-center mb-4">Similar Properties</h3>
    <div class="row g-3">
      <div class="col-md-4">
        <div class="property-card bg-white rounded shadow-sm overflow-hidden h-100">
          <div style="height: 200px; overflow: hidden;">
            <img src="https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=60" alt="Similar property" class="w-100 h-100 object-fit-cover">
          </div>
          <div class="p-3">
            <h6 class="fw-bold mb-1">Luxury Beach Villa</h6>
            <p class="text-muted small mb-2">Miami Beach, USA</p>
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-bold text-primary">₹180/night</span>
              <div class="d-flex align-items-center">
                <i class="fas fa-star text-warning me-1" style="font-size: 12px;"></i>
                <span class="small">4.8</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="property-card bg-white rounded shadow-sm overflow-hidden h-100">
          <div style="height: 200px; overflow: hidden;">
            <img src="https://images.unsplash.com/photo-1571003123894-1f0594d2b5d9?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=60" alt="Similar property" class="w-100 h-100 object-fit-cover">
          </div>
          <div class="p-3">
            <h6 class="fw-bold mb-1">Modern City Apartment</h6>
            <p class="text-muted small mb-2">New York, USA</p>
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-bold text-primary">₹150/night</span>
              <div class="d-flex align-items-center">
                <i class="fas fa-star text-warning me-1" style="font-size: 12px;"></i>
                <span class="small">4.6</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="property-card bg-white rounded shadow-sm overflow-hidden h-100">
          <div style="height: 200px; overflow: hidden;">
            <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=60" alt="Similar property" class="w-100 h-100 object-fit-cover">
          </div>
          <div class="p-3">
            <h6 class="fw-bold mb-1">Historic Townhouse</h6>
            <p class="text-muted small mb-2">Boston, USA</p>
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-bold text-primary">₹120/night</span>
              <div class="d-flex align-items-center">
                <i class="fas fa-star text-warning me-1" style="font-size: 12px;"></i>
                <span class="small">4.7</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Review Modal -->
<% if (currentUser) { %>
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="reviewModalLabel">Write a Review</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="POST" action="/listings/<%= listing._id %>/reviews">
        <div class="modal-body">
          <div class="mb-3">
            <label for="rating" class="form-label fw-semibold">Rating</label>
            <select class="form-select" id="rating" name="review[rating]" required>
              <option value="">Select rating</option>
              <option value="5">⭐⭐⭐⭐⭐ Excellent (5)</option>
              <option value="4">⭐⭐⭐⭐ Very Good (4)</option>
              <option value="3">⭐⭐⭐ Good (3)</option>
              <option value="2">⭐⭐ Fair (2)</option>
              <option value="1">⭐ Poor (1)</option>
            </select>
          </div>
          <div class="mb-3">
            <label for="comment" class="form-label fw-semibold">Your Review</label>
            <textarea class="form-control" id="comment" name="review[comment]" rows="4" placeholder="Share your experience..." required minlength="5" maxlength="500"></textarea>
            <div class="form-text">Minimum 5 characters, maximum 500 characters</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Submit Review</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>
