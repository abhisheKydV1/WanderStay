        // Function to show distance calculator
        window.showDistanceCalculator = function() {
          const distancePopup = new mapboxgl.Popup({ offset: 25 })
            .setLngLat([<%= listing.geometry.coordinates[0] %>, <%= listing.geometry.coordinates[1] %>])
            .setHTML(`
              <div class="text-center">
                <h6 class="mb-2"><i class="fas fa-route me-1"></i>Distance Calculator</h6>
                <p class="mb-2 small">Click on the map to measure distance from this property</p>
                <div class="mb-2">
                  <button class="btn btn-outline-primary btn-sm me-1" onclick="startDistanceMeasurement()">
                    <i class="fas fa-play me-1"></i>Start
                  </button>
                  <button class="btn btn-outline-secondary btn-sm" onclick="clearDistanceMeasurement()">
                    <i class="fas fa-stop me-1"></i>Clear
                  </button>
                </div>
                <div id="distance-info" class="small text-muted">Click "Start" then click points on the map</div>
              </div>
            `)
            .addTo(map);
        };

        // Distance measurement variables
        let distancePoints = [];
        let distanceLine = null;

        // Function to start distance measurement
        window.startDistanceMeasurement = function() {
          distancePoints = [];
          if (distanceLine) {
            map.removeLayer('distance-line');
            map.removeSource('distance-line');
            distanceLine = null;
          }

          map.on('click', function(e) {
            distancePoints.push(e.lngLat);

            if (distancePoints.length === 1) {
              // Add first point marker
              const pointMarker = new mapboxgl.Marker({ color: '#ff0000' })
                .setLngLat(distancePoints[0])
                .addTo(map);
              nearbyMarkers.push(pointMarker);
            } else if (distancePoints.length === 2) {
              // Calculate and display distance
              const distance = distancePoints[0].distanceTo(distancePoints[1]);
              const distanceKm = (distance / 1000).toFixed(2);

              // Add second point marker
              const pointMarker = new mapboxgl.Marker({ color: '#ff0000' })
                .setLngLat(distancePoints[1])
                .addTo(map);
              nearbyMarkers.push(pointMarker);

              // Draw line between points
              map.addSource('distance-line', {
                'type': 'geojson',
                'data': {
                  'type': 'Feature',
                  'properties': {},
                  'geometry': {
                    'type': 'LineString',
                    'coordinates': [
                      [distancePoints[0].lng, distancePoints[0].lat],
                      [distancePoints[1].lng, distancePoints[1].lat]
                    ]
                  }
                }
              });

              map.addLayer({
                'id': 'distance-line',
                'type': 'line',
                'source': 'distance-line',
                'layout': {
                  'line-join': 'round',
                  'line-cap': 'round'
                },
                'paint': {
                  'line-color': '#ff0000',
                  'line-width': 3,
                  'line-dasharray': [2, 2]
                }
              });

              distanceLine = true;

              // Update distance info
              document.getElementById('distance-info').innerHTML = `Distance: ${distanceKm} km`;

              // Stop listening for clicks
              map.off('click');
            }
          });
        };

        // Function to clear distance measurement
        window.clearDistanceMeasurement = function() {
          distancePoints = [];
          if (distanceLine) {
            map.removeLayer('distance-line');
            map.removeSource('distance-line');
            distanceLine = null;
          }
          map.off('click');

          // Remove distance markers
          nearbyMarkers = nearbyMarkers.filter(marker => {
            if (marker._color === '#ff0000') {
              marker.remove();
              return false;
            }
            return true;
          });
        };

