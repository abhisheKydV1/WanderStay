          } else {
            legend.style.display = 'none';
            legendBtn.innerHTML = '<i class="fas fa-info-circle me-1"></i>Show Legend';
          }
        };

      });

      // Add event listener for map error
      map.on('error', function(e) {
        console.error('Map error:', e);
        document.getElementById('map').innerHTML = `
          <div class="d-flex align-items-center justify-content-center h-100 bg-light rounded">
            <div class="text-center text-muted">
              <i class="fas fa-exclamation-triangle fa-3x mb-3 text-warning"></i>
              <p>Map failed to load</p>
              <small>Please check your internet connection and try refreshing</small>
              <small>Error: ${e.error ? e.error.message : 'Unknown error'}</small>
            </div>
          </div>
        `;
      });

      // Fallback timeout
      setTimeout(function() {
        const mapContainer = document.getElementById('map');
        if (mapContainer && mapContainer.querySelector('.fa-spinner')) {
          console.log('Map loading timeout, showing fallback');
          mapContainer.innerHTML = `
            <div class="d-flex align-items-center justify-content-center h-100 bg-light rounded">
              <div class="text-center text-muted">
                <i class="fas fa-map-marked-alt fa-3x mb-3"></i>
                <p>Map temporarily unavailable</p>
                <small>The interactive map is currently loading. Please refresh the page.</small>
              </div>
            </div>
          `;
        }
      }, 10000); // 10 second timeout

    } catch (error) {
      console.error('Map creation error:', error);
      document.getElementById('map').innerHTML = `
        <div class="d-flex align-items-center justify-content-center h-100 bg-light rounded">
          <div class="text-center text-muted">
            <i class="fas fa-exclamation-triangle fa-3x mb-3 text-danger"></i>
            <p>Map creation failed</p>
            <small>Error: ${error.message}</small>
          </div>
        </div>
      `;
    }
    <% } else { %>
    // No geometry data available, show placeholder
    document.getElementById('map').innerHTML = `
      <div class="d-flex align-items-center justify-content-center h-100 bg-light rounded">
        <div class="text-center text-muted">
          <i class="fas fa-map-marked-alt fa-3x mb-3"></i>
          <p>Map not available for this location</p>
          <small>Location coordinates are missing</small>
        </div>
      </div>
    `;
    <% } %>
  });
</script>
