<!DOCTYPE html>
<html lang="en">
  <%- include("../includes/head") %>
  <body>

    <div class="container-fluid px-4 py-5">
      <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">

          <!-- Header -->
          <div class="text-center mb-5">
            <h1 class="display-5 fw-bold text-primary mb-3">
              <i class="fas fa-plus-circle me-3"></i>Add New Listing
            </h1>
            <p class="lead text-muted">
              Share your property with travelers worldwide and start earning
            </p>
          </div>

          <!-- Card -->
          <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-4 p-lg-5">

              <!-- Flash Messages -->
              <% if (locals.successMessage && locals.successMessage.length > 0) { %>
                <div class="alert alert-success"><%= locals.successMessage %></div>
              <% } %>

              <% if (locals.errorMessage && locals.errorMessage.length > 0) { %>
                <div class="alert alert-danger"><%= locals.errorMessage %></div>
              <% } %>

              <!-- FORM -->
              <form method="POST" action="/listings" enctype="multipart/form-data">

                <!-- Title -->
                <div class="mb-4">
                  <label class="form-label fw-semibold">Property Title</label>
                  <input 
                    type="text"
                    name="listing[title]"
                    class="form-control <%= locals.errors?.title ? 'is-invalid' : '' %>"
                    value="<%= listing?.title || '' %>"
                    required
                  >
                  <% if (locals.errors?.title) { %>
                    <div class="invalid-feedback"><%= errors.title.message %></div>
                  <% } %>
                </div>

                <!-- Description -->
                <div class="mb-4">
                  <label class="form-label fw-semibold">Description</label>
                  <textarea 
                    name="listing[description]"
                    class="form-control <%= locals.errors?.description ? 'is-invalid' : '' %>"
                    rows="4"
                    required
                  ><%= listing?.description || '' %></textarea>
                  <% if (locals.errors?.description) { %>
                    <div class="invalid-feedback"><%= errors.description.message %></div>
                  <% } %>
                </div>

                <!-- Image Upload -->
                <div class="mb-4">
                  <label class="form-label fw-semibold">Upload Image</label>
                  <input 
                    type="file"
                    name="image"
                    class="form-control <%= locals.errors?.image ? 'is-invalid' : '' %>"
                    accept="image/*"
                    required
                  >
                  <% if (locals.errors?.image) { %>
                    <div class="invalid-feedback">Image is required</div>
                  <% } %>
                </div>

                <!-- Price -->
                <div class="mb-4">
                  <label class="form-label fw-semibold">Price (₹ per night)</label>
                  <input 
                    type="number"
                    name="listing[price]"
                    class="form-control <%= locals.errors?.price ? 'is-invalid' : '' %>"
                    value="<%= listing?.price || '' %>"
                    required
                  >
                  <% if (locals.errors?.price) { %>
                    <div class="invalid-feedback"><%= errors.price.message %></div>
                  <% } %>
                </div>

                <!-- Country -->
                <div class="mb-4">
                  <label class="form-label fw-semibold">Country</label>
                  <input 
                    type="text"
                    name="listing[country]"
                    class="form-control <%= locals.errors?.country ? 'is-invalid' : '' %>"
                    value="<%= listing?.country || '' %>"
                    required
                  >
                  <% if (locals.errors?.country) { %>
                    <div class="invalid-feedback"><%= errors.country.message %></div>
                  <% } %>
                </div>

                <!-- Location -->
                <div class="mb-4">
                  <label class="form-label fw-semibold">Location</label>
                  <input 
                    type="text"
                    name="listing[location]"
                    class="form-control <%= locals.errors?.location ? 'is-invalid' : '' %>"
                    value="<%= listing?.location || '' %>"
                    required
                  >
                  <% if (locals.errors?.location) { %>
                    <div class="invalid-feedback"><%= errors.location.message %></div>
                  <% } %>
                </div>

                <!-- Submit -->
                <button type="submit" class="btn btn-primary w-100">
                  <i class="fas fa-plus me-2"></i>Add Listing
                </button>

              </form>

            </div>
          </div>

        </div>
      </div>
    </div>

  </body>
</html>