<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Help Center - WanderStay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .help-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 4rem 0;
            margin-top: -1px;
        }
        .help-card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
        }
        .help-card:hover {
            transform: translateY(-5px);
        }
        .help-icon {
            font-size: 2.5rem;
            color: #1ba0d7;
            margin-bottom: 1rem;
        }
        .faq-item {
            border-bottom: 1px solid #eee;
            padding: 1.5rem 0;
        }
        .faq-item:last-child {
            border-bottom: none;
        }
        .contact-card {
            background: linear-gradient(135deg, #1ba0d7 0%, #2c5aa0 100%);
            color: white;
        }
    </style>
</head>
<body>

    <!-- Hero Section -->
    <section class="help-hero">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto text-center">
                    <h1 class="display-4 fw-bold mb-4">How can we help you?</h1>
                    <p class="lead mb-4">Find answers to common questions or get in touch with our support team</p>
                    <div class="row g-3">
                        <div class="col-md-8 mx-auto">
                            <div class="input-group">
                                <input type="text" class="form-control form-control-lg" placeholder="Search for help..." style="border-radius: 25px 0 0 25px;">
                                <button class="btn btn-light btn-lg px-4" style="border-radius: 0 25px 25px 0;">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Quick Help Categories -->
    <section class="py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="help-card card h-100 text-center p-4">
                        <div class="card-body">
                            <i class="fas fa-home help-icon"></i>
                            <h5 class="card-title fw-bold">Getting Started</h5>
                            <p class="card-text text-muted">Learn the basics of using WanderStay</p>
                            <a href="#getting-started" class="btn btn-primary btn-sm">Learn More</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="help-card card h-100 text-center p-4">
                        <div class="card-body">
                            <i class="fas fa-user-check help-icon"></i>
                            <h5 class="card-title fw-bold">Account & Profile</h5>
                            <p class="card-text text-muted">Manage your account settings</p>
                            <a href="#account" class="btn btn-primary btn-sm">Learn More</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="help-card card h-100 text-center p-4">
                        <div class="card-body">
                            <i class="fas fa-calendar-check help-icon"></i>
                            <h5 class="card-title fw-bold">Bookings</h5>
                            <p class="card-text text-muted">Everything about reservations</p>
                            <a href="#bookings" class="btn btn-primary btn-sm">Learn More</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="help-card card h-100 text-center p-4">
                        <div class="card-body">
                            <i class="fas fa-shield-alt help-icon"></i>
                            <h5 class="card-title fw-bold">Safety & Trust</h5>
                            <p class="card-text text-muted">Stay safe while traveling</p>
                            <a href="#safety" class="btn btn-primary btn-sm">Learn More</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <h2 class="text-center mb-5 fw-bold">Frequently Asked Questions</h2>

                    <div class="accordion" id="faqAccordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                    How do I create an account?
                                </button>
                            </h2>
                            <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                                <div class="accordion-body">
                                    Click on "Sign Up" in the top right corner and fill in your details including username, email, and password. You'll be ready to start exploring listings immediately!
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                    How do I add a new listing?
                                </button>
                            </h2>
                            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body">
                                    After logging in, click on your profile menu and select "Add Your Listing". Fill in all the details about your property and click save.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                    How do I search for properties?
                                </button>
                            </h2>
                            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body">
                                    Use the search bar at the top of the page to search by location. You can search for cities, countries, or specific landmarks.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                                    Is WanderStay safe to use?
                                </button>
                            </h2>
                            <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body">
                                    Yes! We verify all listings and user accounts to ensure a safe and trustworthy platform for both hosts and travelers.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="py-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 mx-auto">
                    <div class="contact-card card text-white p-4">
                        <div class="card-body text-center">
                            <i class="fas fa-envelope fa-3x mb-3"></i>
                            <h3 class="card-title fw-bold">Still need help?</h3>
                            <p class="card-text mb-4">Our support team is here to help you with any questions or issues.</p>
                            <a href="mailto:support@wanderstay.com" class="btn btn-light btn-lg">
                                <i class="fas fa-envelope me-2"></i>Contact Support
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>