<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .flash-message {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            min-width: 300px;
            animation: slideIn 0.3s ease-out;
        }

        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        .alert-success {
            border-left: 4px solid #28a745;
        }

        .alert-danger {
            border-left: 4px solid #dc3545;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <h1 class="text-center mb-4">🚀 Flash Messages Demo</h1>
                <p class="text-center text-muted mb-5">Flash messages are temporary notifications that appear after user actions</p>

                <!-- FLASH MESSAGES DISPLAY -->
                <% if (typeof success !== 'undefined' && success.length > 0) { %>
                    <% success.forEach(msg => { %>
                        <div class="alert alert-success alert-dismissible fade show flash-message" role="alert">
                            <strong>✅ Success:</strong> <%= msg %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% }); %>
                <% } %>

                <% if (typeof error !== 'undefined' && error.length > 0) { %>
                    <% error.forEach(msg => { %>
                        <div class="alert alert-danger alert-dismissible fade show flash-message" role="alert">
                            <strong>❌ Error:</strong> <%= msg %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% }); %>
                <% } %>

                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">🧪 Test Flash Messages</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <form method="POST" action="/flash-success">
                                    <button type="submit" class="btn btn-success w-100">
                                        🎉 Show Success Message
                                    </button>
                                </form>
                            </div>

                            <div class="col-md-4">
                                <form method="POST" action="/flash-error">
                                    <button type="submit" class="btn btn-danger w-100">
                                        ❌ Show Error Message
                                    </button>
                                </form>
                            </div>

                            <div class="col-md-4">
                                <form method="POST" action="/flash-multiple">
                                    <button type="submit" class="btn btn-warning w-100">
                                        📢 Multiple Messages
                                    </button>
                                </form>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="row">
                            <div class="col-12">
                                <h6>📚 How Flash Messages Work:</h6>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item">
                                        <strong>1. Set Message:</strong> <code>req.flash('success', 'Message here!');</code>
                                    </li>
                                    <li class="list-group-item">
                                        <strong>2. Display:</strong> <code>&lt;%= success %&gt;</code> in templates
                                    </li>
                                    <li class="list-group-item">
                                        <strong>3. Auto-clear:</strong> Messages disappear after being displayed once
                                    </li>
                                    <li class="list-group-item">
                                        <strong>4. Types:</strong> 'success', 'error', 'info', 'warning'
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="row">
                            <div class="col-12">
                                <h6>🎯 Real-World Examples in Your WanderStay App:</h6>
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Action</th>
                                                <th>Flash Message</th>
                                                <th>Type</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>Login Success</td>
                                                <td>"Welcome back, username!"</td>
                                                <td>success</td>
                                            </tr>
                                            <tr>
                                                <td>Login Failed</td>
                                                <td>"Invalid username or password"</td>
                                                <td>error</td>
                                            </tr>
                                            <tr>
                                                <td>Listing Created</td>
                                                <td>"Listing created successfully!"</td>
                                                <td>success</td>
                                            </tr>
                                            <tr>
                                                <td>Review Deleted</td>
                                                <td>"Review deleted successfully!"</td>
                                                <td>success</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a href="/listings" class="btn btn-outline-primary">🏠 Back to Listings</a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>